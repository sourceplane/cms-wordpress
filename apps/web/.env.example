# Copy to .env.local (git-ignored) for `next dev` and `pnpm build`.
#
# The WordPress site the pages read, with its REST API at <url>/wp-json/wp/v2.
# A build-time value: `next build` inlines it into the server bundle. A
# deployed build takes it from its environment's WORDPRESS_URL secret
# (README → Connecting WordPress). Unset, the site is not connected: it
# renders its bundled sample posts under a "no WordPress site is connected"
# notice.
WORDPRESS_URL=
# Optional: the template's next/image allow-list for media; the URL's own
# when unset. Inert while images are unoptimised (next.config.ts).
WORDPRESS_HOSTNAME=

# The site's public origin, for absolute links (the sitemap, canonical, Open
# Graph and OG-image links). The deploy sets it per environment.
NEXT_PUBLIC_SITE_URL=

# Read at request time by /api/revalidate (the next-revalidate plugin's
# webhook) — here for `next dev`; on stage and prod a Worker secret, see
# .dev.vars.example. Optional: without it every webhook is refused with 401.
WORDPRESS_WEBHOOK_SECRET=

# Optional. Cloudflare Web Analytics beacon token (stands in for Vercel
# Analytics). Unset → no script is rendered.
NEXT_PUBLIC_CF_BEACON_TOKEN=
